# ClaimShield settings. Leave every key empty to run fully offline (deterministic engine + samples).
# Keep comments on their OWN line (never after a value).

# ---- Muse API (Meta first-party) ----
MUSE_BASE_URL=
MUSE_API_KEY=
MUSE_MODEL=muse-spark-1.3
MUSE_MODEL_CHEAP=muse-spark-1.3-contributor

# ---- Baseten (Muse Spark open) ----
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_API_KEY=
BASETEN_MODEL=meta-models/muse-spark-open-1026

# ---- Fireworks (Muse Spark open) ----
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/muse-spark-open

# ---- Local Llama via Ollama (optional, free) — only used by scripts/build_kb.py ----
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b
# for scanned policy PDFs (free, local):  ollama pull llama3.2-vision
OLLAMA_VISION_MODEL=llama3.2-vision

# ---- Prices in USD per 1M tokens (set real values) ----
PRICE_MUSE_IN=1.00
PRICE_MUSE_OUT=4.00
PRICE_MUSE_CHEAP_IN=0.30
PRICE_MUSE_CHEAP_OUT=1.20
PRICE_BASETEN_IN=0.50
PRICE_BASETEN_OUT=1.50
PRICE_FIREWORKS_IN=0.50
PRICE_FIREWORKS_OUT=1.50

# ---- Hard budget stops in USD (leave a reserve) ----
BUDGET_MUSE_USD=140
BUDGET_BASETEN_USD=95
BUDGET_FIREWORKS_USD=95

# ---- Routing ----
# prod = intended map (Muse API: TPA, Advocate, Appeal, Jury, Voice · Baseten: extraction, evidence · Fireworks: critic, localizer, chat)
# dev  = same, but Muse API roles run on Baseten to save Muse credits while building
PROFILE=prod
# live | replay | off
LLM_MODE=live
CACHE_READ=true
USE_SIDECAR=false
# Leave empty unless your provider supports it, e.g. {"reasoning_effort":"medium"}
REASONING_PARAMS_JSON=
MAX_AGENT_TURNS=6
PAGE_DPI=110
MAX_POLICY_PAGES_TO_LLM=14
REDACT_PII=true
JURISDICTION=IN
JURY_PROVIDERS=muse,baseten,fireworks
MAX_VISION_LOCATES=6

# Optional per-role overrides (roles: extract,tpa,advocate,critic,appeal,localize,chat,voice,single,kb,evidence,jury)
# ROUTE_KB=ollama,baseten,fireworks
# ROUTE_TPA=muse,baseten
